# Insert path to the pkl files containing the FP SNPs collections.
# Include the path only containing the base name of the files.
# 1 chunk is 100.000 variants

[pkl_paths]
    pkl_hg18 = pkls/hg18-
    pkl_GRCh37 = pkls/GRCh37-
    pkl_GRCh38 = pkls/GRCh38-
    pkl_T2T = pkls/T2T-

[chunks]
    n_chunks = 1

[json]
    path_json = "./100VCFs_results.json"

[version]
    version = "1.0.0"
